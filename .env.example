# Optional: require this password for search/thumbnail/redgifs/buddy.
# Send via header: X-Search-Password: yourpassword
SITE_PASSWORD=

# Cache TTL for repeated AV searches (seconds). Default: 180
CACHE_TTL_SECONDS=180

# Buddy chat — DeepSeek V4 Flash
# Set at least one key. If both are set, DeepSeek is used unless LLM_PROVIDER=openrouter.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional: deepseek | openrouter
LLM_PROVIDER=

# Optional model override
# DeepSeek default: deepseek-v4-flash
# OpenRouter default: deepseek/deepseek-v4-flash-0731
LLM_MODEL=
